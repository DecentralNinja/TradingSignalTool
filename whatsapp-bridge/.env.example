PORT=3000
# Shared secret the Lambda must send in the x-bridge-secret header
BRIDGE_SECRET=
# The channel's JID (e.g. 120363412044603667@newsletter). The account linked
# via QR code must be a channel ADMIN (promoted via WhatsApp's own UI -- see
# index.js) and must be a DIFFERENT account than the recipient, since
# WhatsApp doesn't push notifications for self-sent/self-owned content.
CHANNEL_JID=

# Supabase project (same one the fetcher writes to)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bitget UTA API key. Use a Demo Trading key while testing (BITGET_DEMO=true
# adds the paptrading:1 header); switch to a real-money key + BITGET_DEMO=false
# only once the feature is proven out.
BITGET_DEMO=true
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Position sizing: a Full-size (100%) signal risks MAX_MARGIN_PCT of the
# REAL account balance as margin; Standard (75%) / Reduced (50%) scale down
# from there. Leverage then multiplies that margin into the actual position
# size -- set explicitly on every trade via /account/set-leverage rather than
# trusting whatever default is set on the account.
MAX_MARGIN_PCT=20
BITGET_LEVERAGE=15

# Frontend origin allowed to call /trade/* from the browser (CORS)
DASHBOARD_URL=
