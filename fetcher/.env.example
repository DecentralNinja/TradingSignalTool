SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: WhatsApp alerts for new proven bullish/bearish signals (see
# fetcher/src/notify.js). Posts to a private WhatsApp Channel via our own
# self-hosted bridge (see whatsapp-bridge/) -- WHATSAPP_BRIDGE_URL is the
# bridge's public base URL (e.g. http://<vm-ip>:3000), WHATSAPP_BRIDGE_SECRET
# must match the bridge's BRIDGE_SECRET.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_SECRET=

# Optional: public dashboard base URL. If set, proven-signal WhatsApp alerts
# include a "Take trade" link straight to that signal's action page.
DASHBOARD_URL=
